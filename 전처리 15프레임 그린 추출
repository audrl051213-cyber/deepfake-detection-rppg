# 3. 3초 × 15FPS = 45장 전처리 후 출력 함수
# ============================================
import cv2
import numpy as np
import matplotlib.pyplot as plt

def show_green_clahe_45frames(
    video_path,
    duration=3,
    target_fps=15,
    clip_limit=3.0
):
    """
    3초 동안 초당 15프레임 추출 → 총 45프레임
    각 프레임에 대해:
    - 얼굴 검출 및 crop
    - Green 채널 추출
    - CLAHE 적용
    - 최종 45장 화면 출력
    """

    face_cascade = cv2.CascadeClassifier(
        cv2.data.haarcascades + "haarcascade_frontalface_default.xml"
    )

    cap = cv2.VideoCapture(video_path)

    if not cap.isOpened():
        print("오류: 영상을 열 수 없습니다.")
        print("video_path 확인:", video_path)
        return None

    original_fps = cap.get(cv2.CAP_PROP_FPS)

    if original_fps == 0 or np.isnan(original_fps):
        original_fps = 30

    print(f"원본 영상 FPS: {original_fps:.2f}")

    target_frames = duration * target_fps  # 3 * 15 = 45

    print(f"사용 구간: {duration}초")
    print(f"목표 FPS: {target_fps}")
    print(f"목표 프레임 수: {target_frames}장")

    # 3초 동안 15FPS 기준으로 뽑을 프레임 인덱스 생성
    frame_indices = [
        int(i * original_fps / target_fps)
        for i in range(target_frames)
    ]

    clahe = cv2.createCLAHE(
        clipLimit=clip_limit,
        tileGridSize=(8, 8)
    )

    processed_frames = []
    last_face_box = None
    last_processed_img = None

    for target_idx in frame_indices:
        cap.set(cv2.CAP_PROP_POS_FRAMES, target_idx)
        ret, frame = cap.read()

        if not ret:
            break

        # 얼굴 검출
        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

        faces = face_cascade.detectMultiScale(
            gray,
            scaleFactor=1.05,
            minNeighbors=3,
            minSize=(50, 50)
        )

        # 얼굴 검출 시 가장 큰 얼굴 사용
        if len(faces) > 0:
            faces = sorted(
                faces,
                key=lambda f: f[2] * f[3],
                reverse=True
            )
            last_face_box = faces[0]

        # 얼굴이 한 번도 안 잡혔으면 중앙 crop
        elif last_face_box is None:
            h, w = frame.shape[:2]
            box_size = min(h, w) // 2
            last_face_box = (
                w // 2 - box_size // 2,
                h // 2 - box_size // 2,
                box_size,
                box_size
            )

        x, y, w, h = last_face_box

        x = max(0, x)
        y = max(0, y)
        w = min(w, frame.shape[1] - x)
        h = min(h, frame.shape[0] - y)

        face_crop = frame[y:y+h, x:x+w]

        if face_crop.size == 0:
            continue

        # Green 채널 추출
        green_channel = face_crop[:, :, 1]

        # CLAHE 적용
        green_clahe = clahe.apply(green_channel)

        # 보기 쉽게 컬러맵 적용
        green_colormap = cv2.applyColorMap(green_clahe, cv2.COLORMAP_JET)

        # matplotlib 출력용 BGR -> RGB 변환
        green_rgb = cv2.cvtColor(green_colormap, cv2.COLOR_BGR2RGB)

        processed_frames.append(green_rgb)
        last_processed_img = green_rgb.copy()

    cap.release()

    # 프레임 부족 시 마지막 프레임 복사해서 45장 맞춤
    while len(processed_frames) < target_frames and last_processed_img is not None:
        processed_frames.append(last_processed_img.copy())

    print(f"전처리된 프레임 수: {len(processed_frames)}장")

    if len(processed_frames) == 0:
        print("출력할 이미지가 없습니다.")
        return None

    # 마지막에 45장 출력 (5행 x 9열)
    plt.figure(figsize=(18, 10))

    for i in range(target_frames):
        plt.subplot(5, 9, i + 1)
        plt.imshow(processed_frames[i])
        plt.axis("off")
        plt.title(f"{i+1}", fontsize=8)

    plt.tight_layout()
    plt.show()

    return processed_frames


